# 教学视频内容提取与总结工具 - 环境变量配置模板
# 复制此文件为 .env，填入实际值
# .env 文件已被 .gitignore 排除，不会提交到 GitHub

# ============================================================
# DeepSeek 云端 API 配置
# ============================================================
# DeepSeek API Key（必填，用于云端 LLM 调用）
# 获取地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-你的DeepSeek_API_Key

# DeepSeek 模型名（不同模型价格不同，按需选择）
# 可选：deepseek-v4-flash / deepseek-v4-pro 等
DEEPSEEK_MODEL=deepseek-v4-flash

# DeepSeek API 地址（一般不需要改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ============================================================
# 本地 4090 vLLM 服务配置
# ============================================================
# vLLM 服务地址（改为你的 4090 工作站实际局域网 IP）
# 格式：http://IP:端口/v1
VLLM_BASE_URL=http://IP:端口/v1

# vLLM 加载的模型名称（需与 4090 端启动 vLLM 时指定的模型名一致）
VLLM_MODEL=qwen3.6-27b-awq

# ============================================================
# 可选配置
# ============================================================
# 日志级别（DEBUG/INFO/WARNING/ERROR）
# LOG_LEVEL=INFO
