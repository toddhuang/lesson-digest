# 教学视频内容提取与总结工具 - 环境变量配置模板
# 复制此文件为 .env，填入实际值
# .env 文件已被 .gitignore 排除，不会提交到 GitHub

# ============================================================
# LLM 服务商配置（支持多服务商，在 config.yaml 中指定 default_provider）
# ============================================================

# --- DeepSeek（默认推荐，数学推理强，价格低）---
# 获取地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-你的DeepSeek_API_Key
# 模型名（不同模型价格不同）
# 可选：deepseek-v4-flash / deepseek-v4-pro / deepseek-chat 等
DEEPSEEK_MODEL=deepseek-v4-flash
# API 地址（一般不需要改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- 火山引擎豆包（中文教育场景优化，知识点提取质量高）---
# 获取地址：https://ai.volcengine.com/ （火山方舟控制台创建 API Key）
VOLCENGINE_API_KEY=你的火山引擎API_Key
# 模型名（不同模型价格不同）
# 可选：doubao-seed-2-1-pro-260628 / doubao-seed-2-1-turbo-260628 / doubao-seed-2-0-lite-260215 等
VOLCENGINE_MODEL=doubao-seed-2-1-pro-260628
# API 地址（一般不需要改）
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ============================================================
# 可选配置
# ============================================================
# 日志级别（DEBUG/INFO/WARNING/ERROR）
# LOG_LEVEL=INFO
